            }
        },
        "ph": {
            "regex": {
                "[Pp]h": "f",
                "PH": "F"
            }
        },
        "air": {
            "regex": {
                "eir": "air",
                "(th)ere(?=[^a-z]|$)": "air",
                "(wh)ere(?=[^a-z]|$)": "air",
                "([bwp])ear(?=[^a-z]|$)": "air",
                "(?<=[^aeiou])are(?=[^a-z]|$)": "air"
            }
        },
        "wh": {
            "regex": "[Ww]h",
            "replace": "w"
        },
        "ck": {
            "regex": {
                "[Cc]k": "k",
                "CK": "kk"
            }
        },
        "sc": {
            "regex": {
                "sc(?=[eiy])": "s",
                "sc": "sk",
                "[Ss]c(?=[eiy])": "s",
                "[Ss]c": "sk",
                "SC(?=[eiy])": "S",
                "SC": "SK"
            }
        },
        "cc": {
            "regex": {
                "[Cc]c(?=[eiy])": "ks",
                "[Cc]c": "k",
                "CC(?=[eiy])": "KS",
                "CC": "KK"
            }
        },
        "dg": {
            "regex": "dg(?=[eiy])",
            "replace": "j"
        },
        "c": {
            "regex": {
                "c(?=[eiy])": "s",
                "c(?![heiy])": "k",
                "C(?=[eiy])": "S",
                "C(?![heiy])": "K"
            }
        },
        "gh_before_t_silent": {
            "regex": "(?<=[aeiou])gh(?=t)",
            "replace": ""
        },
        "gh_final_silent": {
            "regex": "(?<=[aeiou])gh(?=[^a-z]|$)",
            "replace": ""
        },
        "x_initial": {
            "regex": "\\bx",
            "replace": "z"
        },
        "x_medial": {
            "regex": "(?<=[aeiou])x(?=[aeiou])",
            "replace": "gz"
        },
        "x_default": {
            "regex": "x",
            "replace": "ks"
        },
        "ll": "l",
